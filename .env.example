# Copy this file to ".env" and fill in values. ".env" is gitignored.
# Docker Compose reads ".env" automatically.

# Hugging Face token — ONLY needed if you enable a GATED model download in the
# Dockerfile (e.g. pyannote). The models bundled by default need NO token.
# At build time this is passed via a BuildKit *secret* (see docker-compose.yml),
# so it never ends up in image layers.
HF_TOKEN=

# Optional tuning (defaults shown)
WHISPER_MODEL=small
NUM_THREADS=4
MATCH_THRESHOLD=0.40
